{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // The plugin compiles against the harness declarations the installed host
    // was built from, rather than the published packages whose versions lag
    // behind. Pointing at lib/types keeps the harness source tree out of this
    // program, so a plugin build never recompiles the host.
    "paths": {
      "@deepseek-ai/cordis": ["F:/deepseek-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["F:/deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-brand": ["F:/deepseek-harness/packages/util/brand/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["F:/deepseek-harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-attachment": ["F:/deepseek-harness/packages/attachment/attachment/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["F:/deepseek-harness/packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-computer-use": ["F:/deepseek-harness/packages/computer-use/computer-use/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-computer-use/brand": ["F:/deepseek-harness/packages/computer-use/computer-use/lib/types/brand.d.ts"],
      "@deepseek-ai/dsh-system-prompt": ["F:/deepseek-harness/packages/core/system-prompt/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
